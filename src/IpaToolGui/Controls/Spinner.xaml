<UserControl x:Class="IpaToolGui.Controls.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="20" Height="20" Foreground="#4F6BFF" IsHitTestVisible="False">
    <Viewbox>
        <Grid Width="20" Height="20">
            <Ellipse Stroke="{Binding Foreground, ElementName=Root}" StrokeThickness="2.5" Opacity="0.22" />
            <Path Data="M10,1.25 A8.75,8.75 0 0 1 18.75,10" Stroke="{Binding Foreground, ElementName=Root}"
                  StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  RenderTransformOrigin="0.5,0.5" Width="20" Height="20" Stretch="None">
                <Path.RenderTransform>
                    <RotateTransform />
                </Path.RenderTransform>
                <Path.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Path.Triggers>
            </Path>
        </Grid>
    </Viewbox>
</UserControl>
