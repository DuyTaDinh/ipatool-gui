<Window x:Class="IpaToolGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:IpaToolGui.Controls"
        xmlns:l="clr-namespace:IpaToolGui.Services"
        Title="IPA Tool GUI" Width="1200" Height="800" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>

        <!-- App icon with letter fallback while the artwork loads -->
        <DataTemplate x:Key="AppIcon64">
            <Grid Width="64" Height="64">
                <Border CornerRadius="15" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="15" BorderBrush="{DynamicResource IconRimBrush}" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding IconImage}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Search / purchases result card -->
        <DataTemplate x:Key="AppCardTemplate">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource LinkArea}" AutomationProperties.AutomationId="CardLink" Tag="{Binding}"
                            Click="Detail_Click" ToolTip="{l:Tr card_details_tooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppIcon64}" />
                            <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12.5"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                <WrapPanel Margin="0,9,0,-6">
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding BundleText}" FontFamily="{StaticResource MonoFont}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Visibility="{Binding HasVersion, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding VersionText}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Visibility="{Binding HasSize, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding SizeText}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Visibility="{Binding HasRating, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding RatingText}" />
                                    </Border>
                                    <Border x:Name="PriceChip" Style="{StaticResource Chip}" Background="{DynamicResource SuccessSoftBrush}">
                                        <TextBlock x:Name="PriceText" Text="{Binding PriceText}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Visibility="{Binding HasPurchaseDate, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding PurchaseDateText}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="{l:Tr card_copy_tooltip}"
                                Tag="{Binding}" Click="CopyBundle_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="{l:Tr card_store_tooltip}"
                                Tag="{Binding}" Click="OpenStore_Click" Margin="2,0,0,0"
                                Visibility="{Binding HasStoreUrl, Converter={StaticResource BoolVis}}" />
                        <Button Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="Versions_Click" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,1,8,0" />
                                <TextBlock Text="{l:Tr card_versions}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="Download_Click" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,1,8,0" />
                                <TextBlock Text="{l:Tr card_download}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFree}" Value="False">
                    <Setter TargetName="PriceChip" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                    <Setter TargetName="PriceText" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Download queue row -->
        <DataTemplate x:Key="DownloadTemplate">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="52" Height="52" VerticalAlignment="Top">
                        <Border CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding App.Initial}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="12" BorderBrush="{DynamicResource IconRimBrush}" BorderThickness="1">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding App.IconImage}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <DockPanel>
                            <Border x:Name="StateChip" DockPanel.Dock="Right" CornerRadius="6" Padding="9,2" Background="{DynamicResource SoftFillBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="StateText" Text="{Binding StateLabel}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}" />
                            </Border>
                            <TextBlock Text="{Binding App.DisplayName}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar Style="{StaticResource ThinProgress}" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}"
                                     Margin="0,10,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}" />
                        <TextBox x:Name="StatusBox" Style="{StaticResource SelectableText}" Text="{Binding StatusText, Mode=OneWay}"
                                 Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="JobOpen_Click"
                                Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,1,8,0" />
                                <TextBlock Text="{l:Tr job_open}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr job_retry}" Tag="{Binding}" Click="JobRetry_Click"
                                Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr job_cancel}" Tag="{Binding}" Click="JobCancel_Click"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{l:Tr job_remove}" Tag="{Binding}"
                                Click="JobRemove_Click" Margin="6,0,0,0"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="StateChip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="StateChip" Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="StateChip" Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                    <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="StatusBox" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Version row -->
        <DataTemplate x:Key="VersionRowTemplate">
            <Border Padding="14,10" CornerRadius="10" Margin="0,0,0,6" Background="{DynamicResource RowBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                            <Border x:Name="LatestChip" Background="{DynamicResource SuccessSoftBrush}" CornerRadius="5" Padding="7,1"
                                    Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="{l:Tr version_latest_badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding IdText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding DateText}" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr version_show}" Tag="{Binding}" Click="VersionInfo_Click"
                                MinHeight="32" Visibility="{Binding CanLoad, Converter={StaticResource BoolVis}}" />
                        <Button Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="VersionDownload_Click" MinHeight="32"
                                Padding="14,0" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,1,7,0" />
                                <TextBlock Text="{l:Tr version_download}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                    <Setter TargetName="LatestChip" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Screenshot in the detail view -->
        <DataTemplate x:Key="ScreenshotTemplate">
            <Border Margin="0,0,12,0" CornerRadius="14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource RowBrush}">
                <Image Source="{Binding}" Height="380" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================================================== SIDEBAR -->
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,24,20,22">
                    <Border Width="40" Height="40" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6C8BFF" Offset="0" />
                                <GradientStop Color="#9257FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="IPA Tool" Foreground="White" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="{l:Tr app_tagline}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16">
                    <Border Background="{DynamicResource SidebarCardBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="38" Height="38">
                                    <Ellipse x:Name="AvatarCircle" Fill="#363A4C" />
                                    <TextBlock x:Name="AvatarText" Text="?" Foreground="White" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AccountEmail" Foreground="{DynamicResource SidebarMutedBrush}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="AccountButton" Style="{StaticResource SidebarButton}" Margin="0,12,0,0" Click="AccountButton_Click" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SidebarCardBrush}" CornerRadius="12" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ToolVersionText" Text="ipatool" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse x:Name="ToolStatusDot" Width="7" Height="7" Fill="#6B7086" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ToolStatusText" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11.5" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SidebarIconButton}" Content="&#xE72C;"
                                    ToolTip="{l:Tr tool_check_tooltip}" Click="CheckUpdate_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Margin="12,0,12,0">
                    <TextBlock Text="{l:Tr nav_menu}" Foreground="#5B5F73" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,8" />
                    <RadioButton x:Name="NavSearch" Style="{StaticResource NavButton}" Tag="&#xE721;" Content="{l:Tr nav_search}"
                                 IsChecked="True" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavPurchases" Style="{StaticResource NavButton}" Tag="&#xE719;" Content="{l:Tr nav_purchases}"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDownloads" Style="{StaticResource NavButton}" Tag="&#xE896;" Checked="Nav_Checked">
                        <DockPanel>
                            <Border x:Name="DownloadBadge" DockPanel.Dock="Right" Background="{DynamicResource AccentBrush}" CornerRadius="9"
                                    MinWidth="20" Height="18" Padding="6,0" Visibility="Collapsed">
                                <TextBlock x:Name="DownloadBadgeText" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{l:Tr nav_downloads}" />
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="{l:Tr nav_log}" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="{l:Tr nav_settings}" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================================================== PAGES -->
        <Grid Grid.Column="1">

            <!-- == SEARCH == -->
            <Grid x:Name="PageSearch" Margin="32,26,32,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Tr search_title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr search_subtitle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Tag="{l:Tr search_placeholder}"
                                     FontSize="15" Padding="38,11,10,11" KeyDown="SearchBox_KeyDown" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource PlaceholderBrush}" FontSize="15"
                                       Margin="14,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                    Padding="24,0" Click="SearchButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <c:Spinner x:Name="SearchSpinner" Foreground="White" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" />
                                    <TextBlock Text="{l:Tr search_button}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <WrapPanel Margin="0,12,0,-6">
                            <TextBlock Text="{l:Tr filter_platform}" Style="{StaticResource InlineLabel}" Margin="0,0,10,6" />
                            <RadioButton GroupName="SearchPlatform" Style="{StaticResource Pill}" Content="iPhone / iPad" Tag="" IsChecked="True" />
                            <RadioButton GroupName="SearchPlatform" Style="{StaticResource Pill}" Content="Mac" Tag="macos" />
                            <RadioButton GroupName="SearchPlatform" Style="{StaticResource Pill}" Content="Apple TV" Tag="appletv" />
                            <RadioButton GroupName="SearchPlatform" Style="{StaticResource Pill}" Content="Apple Watch" Tag="watchos" />
                            <RadioButton GroupName="SearchPlatform" Style="{StaticResource Pill}" Content="Vision Pro" Tag="visionos" />
                            <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="8,3,16,9" />
                            <TextBlock Text="{l:Tr filter_results}" Style="{StaticResource InlineLabel}" Margin="0,0,10,6" />
                            <RadioButton GroupName="SearchLimit" Style="{StaticResource Pill}" Content="10" Tag="10" IsChecked="True" />
                            <RadioButton GroupName="SearchLimit" Style="{StaticResource Pill}" Content="25" Tag="25" />
                            <RadioButton GroupName="SearchLimit" Style="{StaticResource Pill}" Content="50" Tag="50" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <Border x:Name="SearchLoginBanner" Style="{StaticResource WarningBanner}" Margin="0,14,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:Tr account_sign_in}" MinHeight="30"
                                    Margin="12,0,0,0" Click="ShowLogin_Click" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,10,0" FontSize="15" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:Tr search_login_banner}" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="SearchErrorBanner" Style="{StaticResource ErrorBanner}" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBox x:Name="SearchErrorText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource ErrorTextBrush}" />
                    </Border>
                    <TextBlock x:Name="SearchResultInfo" Foreground="{DynamicResource SubtleTextBrush}" Margin="2,16,0,0" Visibility="Collapsed" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SearchResults" ItemTemplate="{StaticResource AppCardTemplate}" Margin="0,0,6,20" />
                    </ScrollViewer>
                    <StackPanel x:Name="SearchEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60">
                        <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="30" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="SearchEmptyTitle" Text="{l:Tr search_empty_title}" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock x:Name="SearchEmptyHint" Text="{l:Tr search_empty_hint}"
                                   Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- == PURCHASES == -->
            <Grid x:Name="PagePurchases" Margin="32,26,32,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Tr purchases_title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr purchases_subtitle}" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,-6">
                            <TextBlock Text="{l:Tr filter_platform}" Style="{StaticResource InlineLabel}" Margin="0,0,10,6" />
                            <RadioButton GroupName="PurchasePlatform" Style="{StaticResource Pill}" Content="{l:Tr platform_all}" Tag="" IsChecked="True" />
                            <RadioButton GroupName="PurchasePlatform" Style="{StaticResource Pill}" Content="iPhone" Tag="iphone" />
                            <RadioButton GroupName="PurchasePlatform" Style="{StaticResource Pill}" Content="iPad" Tag="ipad" />
                            <RadioButton GroupName="PurchasePlatform" Style="{StaticResource Pill}" Content="Mac" Tag="macos" />
                            <RadioButton GroupName="PurchasePlatform" Style="{StaticResource Pill}" Content="Apple TV" Tag="appletv" />
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="PurchasePrev" Style="{StaticResource IconButton}" Content="&#xE76B;" ToolTip="{l:Tr purchases_prev}"
                                    Click="PurchasePrev_Click" IsEnabled="False" />
                            <TextBlock x:Name="PurchasePageText" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"
                                       Margin="6,0" MinWidth="40" TextAlignment="Center" />
                            <Button x:Name="PurchaseNext" Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="{l:Tr purchases_next}"
                                    Click="PurchaseNext_Click" IsEnabled="False" />
                            <Button x:Name="PurchaseLoadButton" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="PurchaseLoad_Click">
                                <StackPanel Orientation="Horizontal">
                                    <c:Spinner x:Name="PurchaseSpinner" Foreground="White" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" />
                                    <TextBlock Text="{l:Tr purchases_load}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2">
                    <Border x:Name="PurchaseErrorBanner" Style="{StaticResource ErrorBanner}" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBox x:Name="PurchaseErrorText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource ErrorTextBrush}" />
                    </Border>
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <ScrollViewer x:Name="PurchaseScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PurchaseResults" ItemTemplate="{StaticResource AppCardTemplate}" Margin="0,0,6,20" />
                    </ScrollViewer>
                    <StackPanel x:Name="PurchaseEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60">
                        <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE719;" FontSize="30" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PurchaseEmptyTitle" Text="{l:Tr purchases_empty_title}" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock x:Name="PurchaseEmptyHint" Text="{l:Tr purchases_empty_hint}" Foreground="{DynamicResource SubtleTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- == DOWNLOADS == -->
            <Grid x:Name="PageDownloads" Margin="32,26,32,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Tr downloads_title}" Style="{StaticResource PageTitle}" />
                        <TextBlock x:Name="DownloadFolderInfo" Style="{StaticResource PageSubtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr downloads_clear}" Click="ClearFinished_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenDownloadFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,1,8,0" />
                                <TextBlock Text="{l:Tr downloads_open_folder}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,20,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DownloadList" ItemTemplate="{StaticResource DownloadTemplate}" Margin="0,0,6,20" />
                    </ScrollViewer>
                    <StackPanel x:Name="DownloadEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60">
                        <Border Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{l:Tr downloads_empty_title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Text="{l:Tr downloads_empty_hint}" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- == LOG == -->
            <Grid x:Name="PageLog" Margin="32,26,32,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Tr log_title}" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr log_subtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{l:Tr log_clear}" Click="ClearLog_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CopyLog_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,1,8,0" />
                                <TextBlock Text="{l:Tr log_copy}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource LogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="14" Margin="0,18,0,0" Padding="6">
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource LogTextBrush}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Padding="10"
                             VerticalScrollBarVisibility="Auto" SelectionBrush="{DynamicResource AccentBrush}" />
                </Border>
            </Grid>

            <!-- == SETTINGS == -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,26,32,30" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="{l:Tr settings_title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Tr settings_subtitle}" />

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Tr appearance_title}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{l:Tr appearance_language}" Style="{StaticResource FieldLabel}" Margin="0,12,0,8" />
                            <WrapPanel x:Name="LanguagePanel">
                                <RadioButton GroupName="Language" Style="{StaticResource Pill}" Content="{l:Tr appearance_auto}" Tag="auto" Checked="Language_Checked" />
                                <RadioButton GroupName="Language" Style="{StaticResource Pill}" Content="Tiếng Việt" Tag="vi" Checked="Language_Checked" />
                                <RadioButton GroupName="Language" Style="{StaticResource Pill}" Content="English" Tag="en" Checked="Language_Checked" />
                                <RadioButton GroupName="Language" Style="{StaticResource Pill}" Content="简体中文" Tag="zh-Hans" Checked="Language_Checked" />
                                <RadioButton GroupName="Language" Style="{StaticResource Pill}" Content="한국어" Tag="ko" Checked="Language_Checked" />
                                <RadioButton GroupName="Language" Style="{StaticResource Pill}" Content="Türkçe" Tag="tr" Checked="Language_Checked" />
                            </WrapPanel>
                            <TextBlock Text="{l:Tr appearance_theme}" Style="{StaticResource FieldLabel}" Margin="0,10,0,8" />
                            <WrapPanel x:Name="ThemePanel">
                                <RadioButton GroupName="Theme" Style="{StaticResource Pill}" Tag="dark" Checked="Theme_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" Margin="0,1,7,0" FontSize="12" />
                                        <TextBlock Text="{l:Tr theme_dark}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Theme" Style="{StaticResource Pill}" Tag="light" Checked="Theme_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" Margin="0,1,7,0" FontSize="12" />
                                        <TextBlock Text="{l:Tr theme_light}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="Theme" Style="{StaticResource Pill}" Tag="system" Checked="Theme_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,1,7,0" FontSize="12" />
                                        <TextBlock Text="{l:Tr theme_system}" />
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Tr folder_title}" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr folder_hint}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" Style="{StaticResource InputBox}" IsReadOnly="True" FontSize="13" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{l:Tr folder_choose}" Margin="8,0,0,0"
                                        Click="BrowseFolder_Click" />
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{l:Tr folder_open}" Margin="8,0,0,0"
                                        Click="OpenDownloadFolder_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Tr dl_title}" Style="{StaticResource CardTitle}" />
                            <CheckBox x:Name="AutoPurchaseCheck" Style="{StaticResource Check}" Margin="0,10,0,0"
                                      Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr autolicense_title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{l:Tr autolicense_hint}" />
                                </StackPanel>
                            </CheckBox>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{l:Tr country_title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{l:Tr country_hint}" />
                                </StackPanel>
                                <TextBox x:Name="CountryBox" Grid.Column="1" Style="{StaticResource InputBox}" Width="80" MaxLength="2"
                                         HorizontalContentAlignment="Center" LostFocus="CountryBox_LostFocus" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ipatool" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr ipatool_hint}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{l:Tr ipatool_installed}" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,24,6" />
                                <TextBlock x:Name="InstalledVerText" Grid.Column="1" Text="—" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="{l:Tr ipatool_latest}" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,24,0" />
                                <TextBlock x:Name="LatestVerText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />
                            </Grid>
                            <ProgressBar x:Name="UpdateProgress" Style="{StaticResource ThinProgress}" Margin="0,14,0,0" Visibility="Collapsed" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="UpdateNowButton" Style="{StaticResource PrimaryButton}" Click="CheckUpdate_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,1,8,0" />
                                        <TextBlock Text="{l:Tr ipatool_check}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr ipatool_open_folder}" Click="OpenToolFolder_Click" Margin="0,0,8,8" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr ipatool_pick}" Click="SetupPickExe_Click" Margin="0,0,8,8" />
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr ipatool_notes}" Click="OpenReleases_Click" Margin="0,0,0,8" />
                            </WrapPanel>
                            <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource Check}" Margin="0,8,0,0"
                                      Checked="SettingsCheck_Changed" Unchecked="SettingsCheck_Changed">
                                <TextBlock Text="{l:Tr ipatool_autoupdate}" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Tr session_title}" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr session_hint}" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr session_copy}" Click="CopyPassphrase_Click" Margin="0,0,8,8"
                                        ToolTip="{l:Tr session_copy_tooltip}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr session_other}" Click="ShowPassphraseEdit_Click" Margin="0,0,8,8" />
                                <Button Style="{StaticResource DangerButton}" Content="{l:Tr session_reset}" Click="ResetSession_Click" Margin="0,0,8,8" />
                            </WrapPanel>
                            <StackPanel x:Name="PassphraseEditPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Tr session_pass_label}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="PassphraseBox" Style="{StaticResource InputPassword}" />
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{l:Tr session_pass_save}" Margin="8,0,0,0"
                                            Click="SavePassphrase_Click" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Tr about_title}" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{l:Tr about_use}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{l:Tr about_disclaimer}" />
                            <Border x:Name="GuiUpdateBanner" Style="{StaticResource InfoBanner}" Margin="0,14,0,0" Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:Tr about_download_update}" MinHeight="30"
                                            Margin="12,0,0,0" Click="GuiUpdate_Click" />
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" FontSize="15" />
                                    <TextBlock x:Name="GuiUpdateText" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </Border>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr about_project}" Click="OpenProject_Click" Margin="0,0,8,8" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr about_check}" Click="CheckGuiUpdate_Click" Margin="0,0,8,8" />
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr about_ipatool_repo}" Click="OpenIpaToolRepo_Click" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===================================================== APP DETAIL OVERLAY -->
        <Grid x:Name="DetailOverlay" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed"
              MouseLeftButtonDown="Overlay_BackgroundClick">
            <Border x:Name="DetailCard" Style="{StaticResource Card}" Padding="0" Margin="48,36" MaxWidth="920"
                    MouseLeftButtonDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.25" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="26,24,20,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="96" Height="96" VerticalAlignment="Top">
                            <Border CornerRadius="22" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock x:Name="DetailInitial" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="22" BorderBrush="{DynamicResource IconRimBrush}" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush x:Name="DetailIcon" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="20,2,12,0">
                            <TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailSeller" Foreground="{DynamicResource SubtleTextBrush}" FontSize="13" Margin="0,3,0,0" />
                            <WrapPanel x:Name="DetailChips" Margin="0,10,0,-6" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Click="DetailDownload_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,1,8,0" />
                                        <TextBlock Text="{l:Tr card_download}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Click="DetailVersions_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,1,8,0" />
                                        <TextBlock Text="{l:Tr card_versions}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DetailStoreButton" Style="{StaticResource SecondaryButton}" Click="DetailStore_Click" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="0,1,8,0" />
                                        <TextBlock Text="{l:Tr detail_open_store}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Content="{l:Tr detail_copy_bundle}" Click="DetailCopy_Click" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top"
                                Click="DetailClose_Click" ToolTip="{l:Tr detail_close}" />
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="26,18,26,26">
                                <StackPanel x:Name="DetailShotsPanel">
                                    <TextBlock Text="{l:Tr detail_screenshots}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Shots_PreviewMouseWheel">
                                        <ItemsControl x:Name="DetailShots" ItemTemplate="{StaticResource ScreenshotTemplate}" Margin="0,0,0,10">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                                <StackPanel x:Name="DetailNotesPanel" Margin="0,18,0,0">
                                    <TextBlock x:Name="DetailNotesTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBox x:Name="DetailNotes" Style="{StaticResource SelectableText}" Foreground="{DynamicResource BodyTextBrush}" FontSize="13" />
                                </StackPanel>
                                <StackPanel x:Name="DetailDescPanel" Margin="0,18,0,0">
                                    <TextBlock Text="{l:Tr detail_description}" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                                    <TextBox x:Name="DetailDesc" Style="{StaticResource SelectableText}" Foreground="{DynamicResource BodyTextBrush}" FontSize="13" />
                                </StackPanel>
                                <Border x:Name="DetailNoInfo" Style="{StaticResource InfoBanner}" Visibility="Collapsed">
                                    <TextBlock TextWrapping="Wrap" Text="{l:Tr detail_no_info}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================== VERSIONS OVERLAY -->
        <Grid x:Name="VersionsOverlay" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed"
              MouseLeftButtonDown="Overlay_BackgroundClick">
            <Border Style="{StaticResource Card}" Padding="0" Width="660" Margin="40" VerticalAlignment="Center" MaxHeight="640"
                    MouseLeftButtonDown="OverlayCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.25" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="24,22,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Tr versions_title}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionsAppName" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="VersionsInfo" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" VerticalAlignment="Top" Click="VersionsClose_Click" />
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="120">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="VersionsList" ItemTemplate="{StaticResource VersionRowTemplate}" Margin="24,0,18,0" />
                        </ScrollViewer>
                        <c:Spinner x:Name="VersionsSpinner" Width="30" Height="30" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="24,12,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="VersionsMore" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Content="{l:Tr versions_more}" Click="VersionsMore_Click" Visibility="Collapsed" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                                   Margin="12,0,0,0" TextAlignment="Right" Text="{l:Tr versions_hint}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================== LOGIN OVERLAY -->
        <Grid x:Name="LoginOverlay" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="460" Padding="30,28" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.25" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" FontSize="20" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="LoginClose_Click" />
                    </Grid>
                    <TextBlock x:Name="LoginTitle" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,4" TextWrapping="Wrap" />
                    <TextBlock x:Name="LoginSubtitle" Style="{StaticResource Hint}" FontSize="13" />

                    <StackPanel x:Name="LoginCredPanel" Margin="0,20,0,0">
                        <TextBlock Text="{l:Tr login_email}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LoginEmail" Style="{StaticResource InputBox}" KeyDown="LoginField_KeyDown" />
                        <TextBlock Text="{l:Tr login_password}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <PasswordBox x:Name="LoginPassword" Style="{StaticResource InputPassword}" KeyDown="LoginField_KeyDown" />
                    </StackPanel>

                    <StackPanel x:Name="Login2faPanel" Margin="0,20,0,0" Visibility="Collapsed">
                        <Border Style="{StaticResource InfoBanner}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock TextWrapping="Wrap" Text="{l:Tr login_2fa_info}" />
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{l:Tr login_2fa_label}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                        <TextBox x:Name="Login2faCode" Style="{StaticResource InputBox}" FontSize="24" FontFamily="{StaticResource MonoFont}"
                                 MaxLength="6" HorizontalContentAlignment="Center" Tag="000000" KeyDown="LoginField_KeyDown" />
                    </StackPanel>

                    <Border x:Name="LoginErrorBox" Style="{StaticResource ErrorBanner}" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBox x:Name="LoginErrorText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource ErrorTextBrush}" />
                    </Border>
                    <TextBlock x:Name="LoginStatusText" Style="{StaticResource Hint}" Margin="0,14,0,0" Visibility="Collapsed" />

                    <Grid Margin="0,22,0,0">
                        <Button x:Name="LoginBackButton" Style="{StaticResource GhostButton}" Content="{l:Tr login_back}" HorizontalAlignment="Left"
                                Click="LoginBack_Click" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr login_cancel}" Click="LoginClose_Click" />
                            <Button x:Name="LoginSubmit" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" MinWidth="130" Click="LoginSubmit_Click">
                                <StackPanel Orientation="Horizontal">
                                    <c:Spinner x:Name="LoginSpinner" Foreground="White" Width="14" Height="14" Margin="0,0,8,0" Visibility="Collapsed" />
                                    <TextBlock x:Name="LoginSubmitText" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,1,8,0"
                                   VerticalAlignment="Top" FontSize="12" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="11.5" Text="{l:Tr login_privacy}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================================================== FIRST-RUN SETUP -->
        <Grid x:Name="SetupOverlay" Grid.ColumnSpan="2" Background="{DynamicResource PageBrush}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="480" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6C8BFF" Offset="0" />
                                <GradientStop Color="#9257FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{l:Tr setup_title}" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,4" />
                    <TextBlock x:Name="SetupText" Style="{StaticResource Hint}" FontSize="13" />
                    <ProgressBar x:Name="SetupProgress" Style="{StaticResource ThinProgress}" Height="8" Margin="0,20,0,0" IsIndeterminate="True" />
                    <Border x:Name="SetupErrorBox" Style="{StaticResource ErrorBanner}" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBox x:Name="SetupErrorText" Style="{StaticResource SelectableText}" Foreground="{DynamicResource ErrorTextBrush}" />
                    </Border>
                    <WrapPanel x:Name="SetupButtons" Margin="0,18,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource PrimaryButton}" Content="{l:Tr setup_retry}" Click="SetupRetry_Click" Margin="0,0,8,8" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{l:Tr setup_pick}" Click="SetupPickExe_Click" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================================================== TOAST -->
        <Border x:Name="Toast" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                Background="#1B1D26" BorderBrush="#2E3240" BorderThickness="1" CornerRadius="12" Padding="16,12" Opacity="0"
                IsHitTestVisible="False" MaxWidth="460">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.3" />
            </Border.Effect>
            <DockPanel>
                <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="15" Margin="0,1,12,0" VerticalAlignment="Top"
                           Foreground="#7CE0A8" Text="&#xE73E;" />
                <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap" FontSize="13" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
